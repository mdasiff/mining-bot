  ],
  "selectors": {
    "title": [
      "h1",
      "[data-label='title']",
      "meta[property='og:title']"
    ],
    "price": [
      "[data-label='PRICE']",
      "[class*='price']",
      "[itemprop='price']"
    ],
    "location": [
      "[data-label='LOCATION']",
      "[class*='loc']",
      "[itemprop='address']"
    ]
  }
}
